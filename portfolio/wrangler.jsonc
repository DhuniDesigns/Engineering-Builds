{
  // Cloudflare Workers config for the portfolio (static files + the Now playing API)
  "name": "dhuni-designs",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "keep_vars": true,
  "vars": { "LASTFM_USER": "dhunidesigns" },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
