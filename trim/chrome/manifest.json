{
  "manifest_version": 3,
  "name": "Trim: shorter AI prompts",
  "short_name": "Trim",
  "version": "0.5.1",
  "description": "Rewrites your Claude.ai prompts shorter so they use fewer tokens. See before and after, then choose.",
  "author": "Hafsoh Bashar",
  "homepage_url": "https://github.com/DhuniDesigns/Engineering-Builds/tree/main/trim",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Trim",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}